/* subpackages/performanceList/performanceList.wxss */


.category {
  display: flex;
  border: 1px solid;
  justify-content: space-evenly;
  align-items: center;
  width: 100%;
  height: 80rpx;
  position: fixed;
  top: 0rpx;
  left: 0rpx;
}

.performance-list {
  margin-top: 100rpx;
  padding: 0rpx 20rpx;
  border: 1px solid;
}



.performance-card {
  border: 1px solid;
  margin-bottom: 25rpx;
  height: 460rpx;
  border-radius: 20rpx;
  position: relative;
}

.performance-card_img {
  height: 300rpx;
  border: 1px solid;
  border-radius: 20rpx 20rpx 0rpx 0rpx;
}

.performance-card_img image {
  width: 100%;
  height: 100%;
}

.performance-card_badge {
  width: 130rpx;
  height: 130rpx;
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: deepskyblue;
  color: #fff;
}

.badge-time {
  font-weight: 600;
}

.performance-card_info {
  padding: 10rpx;
}

.performance-card_title {
  font-weight: 600;
  font-size: 34rpx;
}

.performance-card_tag {
  margin: 5rpx 0rpx;
  display: flex;
}

.performance-card_tag view {
  margin-right: 15rpx;
  border: 1px solid;
  padding: 5rpx;
  width: 70rpx;
  height: 25rpx;
  text-align: center;
  line-height: 25rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  background: chocolate;
}

.performance-card_time-row {
  display: flex;
}

.performance-card_time-list {
  margin-left: 10rpx;
  width: 500rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.performance-card_time-list view {
  font-size: 28rpx;
  line-height: 1.2;
  padding: 0rpx 12rpx;
  border-right: 1px solid #999;
  color: #333;
}

.performance-card_time-list view:last-child {
  border-right: none;
  padding-right: 0;
}


.timeline-container {
  margin-top: 95rpx;

}

.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 40rpx;
  padding-left: 80rpx;
}

.timeline-item_content {
  margin-left: 9rpx;
}

.show-card {
  display: flex;
  padding: 20rpx;
  min-height: 300rpx;
  align-items: center;
  font-size: 24rpx;
}

.show-card_cover {
  width: 150rpx;
  height: 200rpx;
  margin-right: 20rpx;
}

.show-card_cover image {
  width: 100%;
  height: 100%;
}

.show-card_header {}

.show-card_footer {
  display: flex;
}

.timeline-container {
  margin-top: 90rpx;
  padding: 20rpx 0;
}

.timeline-list {
  padding: 0 30rpx 0 10rpx;
}

/* ========== 时间轴每一条 ========== */
.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 20rpx;
}


.timeline-item_axis {
  width: 60rpx;
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-item_dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 4rpx solid #333;
  z-index: 2;
  box-sizing: border-box;
  flex-shrink: 0;
  margin-bottom: 30rpx;
}

.timeline-item_line {
  width: 2rpx;
  background-color: #e0e0e0;
  flex: 1;
  margin-top: 8rpx;
  z-index: 1;
}

.timeline-item_content {
  flex: 1;
  margin-left: 20rpx;
  position: relative;
  padding-top: 10rpx;
}

.timeline-item_time-badge {
  display: inline-block;
  background-color: #fff;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: relative;
  margin-bottom: 30rpx;
}

/* 气泡左侧小三角 */
.timeline-item_time-badge::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  border-width: 12rpx 12rpx 12rpx 0;
  border-style: solid;
  border-color: transparent #fff transparent transparent;
}

.show-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: none;
}

.show-card_cover {
  width: 150rpx;
  height: 210rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: none;
}

.show-card_cover image {
  width: 100%;
  height: 100%;
}

.show-card_main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.show-card_title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.show-card_desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.show-card_time,
.show-card_capacity,
.show-card_notice {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.show-card_notice {
  color: #e74c3c;
  margin-top: 4rpx;
}

.show-card_footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.show-card_action-btn {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.text-blue {
  color: #1a73e8;
}