<view class="page">
  <view class="category">
    <view class="type" bind:tap="displayCategory" data-id="1">按节目展示</view>
    <view class="type" bind:tap="displayCategory" data-id="2">按时间展示</view>
  </view>

  <!-- 按节目展示 -->
  <view class="performance-list" wx:if="{{category ==1}}">
    <scroll-view scroll-y="true" style="height: 1300rpx;" bindscrolltoupper="upper" bindscrolltolower="lower" bindscroll="scroll" scroll-into-view="{{toView}}" scroll-top="{{scrollTop}}">
      <!-- 单个卡片 -->
      <view class="performance-card" wx:for="{{10}}" wx:key="item">
        <view class="performance-card_cover">
          <view class="performance-card_img">
            <!-- <image src="..." mode="aspectFill" /> -->
          </view>
          <view class="performance-card_badge">
            <view class="badge-time">15:30</view>
            <view class="badge-label">下一场</view>
          </view>
        </view>

        <view class="performance-card_info">
          <view class="performance-card_title">最棒的礼物</view>
          <view class="performance-card_time-row">
            <view class="performance-card_time-label">演出时间:</view>
            <view class="performance-card_time-list">15:30 | 16:45 | 18:00</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>



  <!-- 按时间展示 -->
  <view class="timeline-container" wx:else>
    <scroll-view scroll-y="true" style="height: 1300rpx;" bindscrolltoupper="upper" bindscrolltolower="lower" bindscroll="scroll" scroll-into-view="{{toView}}" scroll-top="{{scrollTop}}">
      <view class="timeline-list">
        <view class="timeline-item" wx:for="{{5}}" wx:key="index">
          <view class="timeline-item_axis">
            <view class="timeline-item_dot"></view>
            <view class="timeline-item_line"></view>
          </view>
          <view class="timeline-item_content">
            <view class="timeline-item_time-badge">
              <text>10:40</text>
            </view>
            <view class="show-card">
              <view class="show-card_cover">
                <image src="https://via.placeholder.com/150x200" mode="aspectFill"></image>
              </view>
              <view class="show-card_main">
                <view class="show-card_title">老院子</view>
                <view class="show-card_desc">
                  <view class="show-card_time">时间：10:40~11:08</view>
                  <view class="show-card_capacity">坐定式观演 可容纳300人</view>
                  <view class="show-card_notice">谢绝学龄前儿童观看</view>
                </view>
                <view class="show-card_footer">
                  <view class="show-card_action-btn text-blue">详情 »</view>
                  <view class="show-card_action-btn">☆ 开演提醒</view>
                  <view class="show-card_action-btn">➤ 导航</view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

</view>