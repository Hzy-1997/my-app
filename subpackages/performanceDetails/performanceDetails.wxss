page {
  background-color: #f7f8fa;
  color: #1f2430;
}

.detail-container {}

.container_img {
  border: 1px solid;
}

.header {
  margin-bottom: 36rpx;
  padding: 32rpx 28rpx 0rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2430;
  line-height: 1.4;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #ff9f4d;
}

.tag-row {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 10rpx 20rpx;
  background-color: #eef4ff;
  color: #3566dd;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.section {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.html {
  min-height: 450rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2430;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #4a5060;
  line-height: 1.6;
}

.schedule-item {
  font-size: 28rpx;
  color: #4a5060;
  padding: 15rpx 0;
  display: flex;
  justify-content: space-between;
  border-bottom: 0.5px solid #e5e5e5;
}

.schedule-item:last-child {
  border-bottom: none;
}

.remind {
  display: flex;
  justify-content: center;
  align-items: center;
}

.image {
  width: 35rpx;
  height: 35rpx;
  margin-right: 10rpx;
}

.image image {
  width: 35rpx;
  height: 35rpx;
}

.bottom-spacing {
  height: 40rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.reserve-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(90deg, #35ccdd 0%, #ff9f43 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
}

.reserve-btn::after {
  border: none;
}