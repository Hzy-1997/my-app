<view>

  <nav-bar id="nav-bar" title="{{navTitle}}" />
  <view class="detail-container">
    <!-- 自定义顶部导航栏 -->

    <view class="container_img">
      <image src="" mode="" />
    </view>

    <!-- 顶部标题区 -->
    <view class="header">
      <view class="title">{{program.title}}</view>
      <view class="subtitle" wx:if="{{program.subtitle}}">{{program.subtitle}}</view>
      <view class="tag-row" wx:if="{{program.tags && program.tags.length}}">
        <view class="tag" wx:for="{{program.tags}}" wx:key="*this">{{item}}</view>
        <view class="tag" wx:if="{{program.duration}}">{{program.duration}}</view>
        <view class="tag" wx:if="{{program.suitableAge}}">{{program.suitableAge}}</view>
      </view>
    </view>

    <!-- 活动时间 -->
    <view class="section" wx:if="{{program.schedules && program.schedules.length}}">
      <view class="section-title">活动时间</view>
      <view class="schedule-item" wx:for="{{program.schedules}}" wx:key="id">
        <view> 场次{{index + 1}}：{{item.showTime}}</view>
        <view class="remind" bind:tap="showPopup" data-date="{{item.showTime}}">
          <view class="image" wx:if="{{item.isAppointment ==1}}">
            <image src="../../assets/image/starA.png" mode="" />
          </view>
          <view class="image" wx:else>
            <image src="../../assets/image/starB.png" mode="" />
          </view>
          开演提醒
        </view>
      </view>
    </view>

    <!-- 活动地点 -->
    <view class="section" wx:if="{{program.locationDesc}}">
      <view class="section-title">活动地点</view>
      <view class="section-content">{{program.locationDesc}}</view>
    </view>

    <!-- 适合人群 -->
    <view class="section" wx:if="{{program.suitableCrowd && program.suitableCrowd.length}}">
      <view class="section-title">适合人群</view>
      <view class="section-tags">
        <view class="section-tag" wx:for="{{program.suitableCrowd}}" wx:key="index">{{item}}</view>
      </view>
    </view>

    <!-- 注意事项 -->
    <view class="section" wx:if="{{program.notice}}">
  <view class="section-title">注意事项</view>
  <view class="section-notice">
    <text class="section-notice-icon">!</text>
    <text class="section-notice-text">{{program.notice}}</text>
  </view>
</view>

    <!-- 节目简介 -->
    <view class="section html" wx:if="{{program.introduction}}">
      <view class="section-title">节目简介</view>
      <!-- <view class="section-content">{{program.introduction}}</view> -->
      <mp-html content="{{program.introduction}}" />
    </view>

    <!-- 底部占位，避免按钮遮挡内容 -->
    <!-- <view class="bottom-spacing"></view> -->
  </view>

  <!-- 底部预约按钮 -->
  <!-- <view class="footer" wx:if="{{program.isReservationRequired}}">
    <button class="reserve-btn" bindtap="goReserve">预约报名</button>
  </view> -->

  <van-popup show="{{ show }}" position="bottom" closeable bind:close="onClose" round custom-style="padding-bottom: env(safe-area-inset-bottom);">
    <view class="remindBox">

      <!-- 预约场次区域 -->
      <view class="session-info">
        <view class="session-label">当前预约场次</view>
        <view class="session-value active time">{{ time }}</view>
      </view>

      <!-- 提醒时间选择区域 -->
      <view class="remindTitle">选择你要提醒的时间</view>

      <view class="remindTime">
        <view class="time {{ selectedIndex === index ? 'active' : '' }}" wx:for="{{ reminderArray }}" wx:key="*this" data-index="{{ index }}" bind:tap="handleSelectTime">
          开始前{{ item }}分钟
        </view>
      </view>

      <!-- 底部确定按钮 -->
      <view class="btn" bind:tap="startReminding">确定</view>

    </view>
  </van-popup>

</view>