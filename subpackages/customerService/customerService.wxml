<view class="page-header">
  <nav-bar id="nav-bar" title="{{navTitle}}" backShow="{{true}}" />

  <!-- 在线客服 -->
  <view class="online-service-main">
    <view style=" color: #fff;">
      <view class="service-title">游客服务</view>
      <view class="service-text">光雾山景区服务中心</view>
      <view class="service-time">服务时间：08:00-18:00</view>
    </view>
  </view>

  <view class="online-service-main-box">
    <view class="online-service-title">
      <view>客服服务</view>
    </view>

    <view class="online-service-box">
      <view>
        <view class="online-service-main_title">智能客服</view>
        <view class="online-service-main_text">在线客服为您解答疑问</view>
      </view>
      <view class="online-service-main_arrow">立即咨询</view>
    </view>


    <view class="online-service-tele-box">
      <view class="online-service-box">
        <view>
          <view class="online-service-main_title">服务热线</view>
          <view class="online-service-main_text">0827-8861279</view>
        </view>
        <view class="online-service-main_arrow">一键拨打</view>
      </view>
    </view>
  </view>

  <!--  便民服务-->
  <view class="grid-service-box">
    <view class="service-title">便民服务</view>
    <view class="function-grid">
      <view class="function-grid_item" wx:for="{{data}}" wx:key="item">
        <view class="grid-item_icon">
          <image src="" mode="" />
        </view>
        <view class="grid-item_title">{{item.title}}</view>
        <view class="grid-item_text">{{item.text}}</view>
      </view>
    </view>
  </view>

</view>