.page-header {
  border: 1px solid;
  padding: 0rpx 30rpx;
}

.online-service-main {
  width: 100vw;
  height: 350rpx;
  border: 1px solid;
  position: fixed;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.online-service-main_icon {
  width: 200rpx;
  height: 200rpx;
  border: 1px solid;
}

.online-service-title-box {
  display: flex;
  width: 200rpx;
  border: 1px solid;
  align-items: center;
  justify-content: center;
}

.online-service-main_title {
  /* margin-top: 20rpx; */
  font-weight: 600;
  font-size: 35rpx;
}





.hotline-card {
  width: 100%;
  border: 1px solid;
  height: 200rpx;
  margin-top: 350rpx;
}


.function-grid {
  width: 100%;
  max-height: 900rpx;
  border: 1px solid;
  display: grid;
  grid-template-columns: auto auto;
  /* grid-column-gap: 20px; */
  gap: 20px;
}

.function-grid_item {
  border: 1px solid;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}