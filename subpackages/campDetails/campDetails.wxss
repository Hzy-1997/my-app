/* 整个顶部区域容器 */
.page-header {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

/* 导航栏主体 */
.top-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 标题居中 */
  position: relative;
  /* 为绝对定位的返回按钮提供参考 */
  box-sizing: border-box;
  transition: background-color 0.3s ease;
  /* 平滑过渡效果 */
}

/* 返回按钮 - 绝对定位在左侧 */
.back-btn {
  position: absolute;
  left: -10rpx;
  bottom: 0;
  height: 88rpx;
  /* 与胶囊按钮高度相近 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  z-index: 10;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

/* 标题样式 */
.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  max-width: 60%;
  /* 防止标题过长遮挡按钮 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}


.banner {
  border: 1px solid;
  height: 1000rpx;
  width: 100%;
}


.content {
  margin-top: -50rpx;
  border-radius: 25rpx 25rpx 0rpx 0rpx;
  padding: 30rpx 50rpx;
  background: #fff;
}

.deputy-title {
  font-size: 40rpx;
  font-weight: 900;
}

.tags {
  margin-top: 30rpx;
  display: flex;
}

.tag {
  border: 1px solid;
  margin-right: 20rpx;
  padding: 5rpx 10rpx;
  border-radius: 0rpx 15rpx 0rpx 15rpx;
}

.price {
  margin-top: 30rpx;
  color: red;
}

.price__num {
  font-size: 50rpx;
  font-weight: 900;
}

.info {
  margin-top: 6rpx;
  padding: 30rpx 50rpx;
  background: #fff;

}

.info__row {
  display: flex;
  margin-top: 30rpx;
}

.info__label {
  font-size: 38rpx;
  margin-right: 30rpx;
}

.info__text {
  font-size: 38rpx;
  font-weight: 600;
}

.info__link {
  margin-top: 40rpx;
  color: #21774A;
  font-weight: 200;
}

.rich-text-container {
  margin-top: 6rpx;
  padding: 60rpx 50rpx;
}

.botton-btn {
  position: fixed;
  bottom: 0rpx;
  width: 100%;
  height: 160rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
}

.botton-btn view:nth-child(1) {
  margin-left: 40rpx;
}

.botton-btn view:nth-child(3) {
  width: 320rpx;
  height: 100rpx;
  margin-right: 40rpx;
  text-align: center;
  line-height: 100rpx;
  color: #fff;
  font-weight: 600;
  background: #21774A;
  border-radius: 15rpx;
}