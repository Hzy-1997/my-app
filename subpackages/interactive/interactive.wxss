.container {
  background-color: #f6f5f0;
  min-height: 100vh;
  padding-bottom: 50rpx;
}

/* 顶部导航 */
.nav-header {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  background-color: #1a1a1a;
  color: #fff;
}
.nav-item {
  font-size: 32rpx;
  color: #999;
  padding-bottom: 10rpx;
}
.nav-item.active {
  color: #fff;
  border-bottom: 4rpx solid #b73227;
}

/* 顶部海报 */
.hero-section {
  position: relative;
  width: 100%;
  height: 500rpx;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-text-overlay {
  position: absolute;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  color: #fff;
}
.hero-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  text-shadow: 2rpx 2rpx 8rpx rgba(0,0,0,0.8);
  color: #ffb8b8; /* 互动页面的标题带点淡红色 */
}
.hero-subtitle {
  font-size: 28rpx;
  text-shadow: 2rpx 2rpx 8rpx rgba(0,0,0,0.8);
}

/* 内容区 */
.content-body {
  padding: 40rpx;
}
.intro-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 50rpx;
}

/* 区块通用 */
.section {
  margin-bottom: 60rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  position: relative;
}
.section-title::before {
  content: '';
  position: absolute;
  left: -20rpx;
  top: 10rpx;
  width: 8rpx;
  height: 30rpx;
  background-color: #b73227;
}
.section-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 图文卡片行 */
.card-row {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.card-img {
  width: 200rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.card-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

/* 标签组 */
.tags-container {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.tag-box {
  flex: 1;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}
.tag-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.tag-desc {
  font-size: 22rpx;
  color: #777;
  line-height: 1.4;
  text-align: left;
}

/* 场景关键词特定样式 */
.keyword-text {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.keyword-item {
  font-size: 28rpx;
  color: #555;
}
.keyword-bold {
  font-weight: bold;
  color: #1a1a1a;
}