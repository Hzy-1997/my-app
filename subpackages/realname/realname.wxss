/* subpackages/realname/realname.wxss */

.page-container {
  height: 100vh;
  background: #ffff;
}

.notice-bar {
  padding: 30rpx 0rpx;
  background: #E3F0FE;
  text-align: center;
  margin-bottom: 80rpx;
}

.card-box {
  padding: 0rpx 20rpx;

  border-radius: 30rpx;
  margin: 0rpx 10rpx;
}

.upload-card {

  padding: 20rpx 20rpx;
  border-radius: 30rpx 30rpx 0rpx 0rpx;
}

.upload-area-box {
  display: flex;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  margin-bottom: 10rpx;
  text-align: center;
  font-weight: 600;
}

.upload-card-box {
  width: 320rpx;
  height: 350rpx;


}

.upload-area {
  border: 1px dashed;
  height: 200rpx;
  padding: 20rpx;
}

.upload-area__camera-icon {
  width: 100%;
  height: 100%;
}




.form-area {
  margin-top: 40rpx;

}

.form-item {
  display: flex;
  align-items: center;
  min-height: 50rpx;
  padding: 10rpx;
  border-bottom: 2rpx solid #f5f5f5;
  position: relative;
}

/* .form-item:last-child {
  border-bottom: none;
} */

.form-label {
  font-size: 30rpx;
  color: #333;
  width: 170rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  padding: 10rpx 0;
  min-height: 60rpx;
}


.upload-card-bottom {
  background: #E3F0FE;
  padding: 20rpx 20rpx;
  border-radius: 0rpx 0rpx 30rpx 30rpx;
}

.my-input-class {
  color: #333 !important;
}


.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  width: 100%;
}

.submit-inner {
  background: #21774A;
  width: 500rpx;
  height: 80rpx;
  border-radius: 50rpx;
  color: #fff;
  text-align: center;
  line-height: 80rpx;
  margin-top: 500rpx;
}