<view class="page-container upload-page">

  <!-- 1. 顶部提示 -->
  <view class="notice-bar">
    <text class="notice-bar__icon">!</text>
    <text class="notice-bar__text">请提交本人真实信息，否则使用功能存在缺失。</text>
  </view>

  <view class="card-box">
    <!-- 2. 正面身份证卡片 -->
    <view class="upload-card">
      <!-- 上传区域 -->
      <view class="upload-area-box">

        <view class="upload-card-box">
          <view class="card-title">上传身份证正面</view>
          <view class="upload-area upload-area--front">
            <image class="upload-area__camera-icon" src="../../assets/image/idCardFront.png"></image>
            <!-- <image class="upload-area__camera-icon" src="../../assets/image/idCardFront.png"></image> -->
          </view>
        </view>

        <view class="upload-card-box">
          <view class="card-title">上传身份证反面</view>
          <view class="upload-area upload-area--back">
            <image class="upload-area__camera-icon" src="../../assets/image/idCardBack.png"></image>
            <!-- <image class="upload-area__camera-icon" src="../../assets/image/idCardBack.png"></image> -->
          </view>
        </view>
      </view>

      <!-- 表单区域 -->
      <view class="form-area">
        <view class="form-item">
          <text class="form-label">姓名：</text>
          <input class="form-input" type="text" value="{{userInformation.nickName}}" placeholder="昵称" disabled bindinput="onNicknameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">身份证号：</text>
          <input class="form-input" type="text" value="{{userInformation.nickName}}" placeholder="身份证号" disabled bindinput="onNicknameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">住址：</text>
          <input class="form-input" type="text" value="{{userInformation.nickName}}" placeholder="住址" disabled bindinput="onNicknameInput" />
        </view>
      </view>
    </view>


    <view class="submit">
      <view class="submit-inner">提交</view>
    </view>
  </view>

</view>