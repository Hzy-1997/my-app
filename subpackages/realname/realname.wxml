<view class="page-container upload-page">

  <!-- 1. 顶部提示 -->
  <view class="notice-bar">
    <text class="notice-bar__icon">!</text>
    <text class="notice-bar__text">请提交本人真实信息，否则使用功能存在缺失。</text>
  </view>

  <view class="card-box">
    <!-- 2. 正面身份证卡片 -->
    <view class="upload-card-top">
      <view class="card-title">上传身份证正面(人像面)</view>

      <!-- 上传区域 -->
      <view class="upload-area upload-area--front">
        <image class="upload-area__camera-icon" src="../../assets/image/idCardFront.png"></image>
      </view>

      <!-- 表单区域 -->
      <view class="form-area">
        <view class="form-item">
          <text class="form-item__label">姓名</text>
          <input class="form-item__input" placeholder="请输入姓名" placeholder-class="input-placeholder" />
        </view>
        <view class="form-item">
          <text class="form-item__label">身份证号</text>
          <input class="form-item__input" placeholder="请输入身份证号" placeholder-class="input-placeholder" />
        </view>
        <view class="form-item">
          <text class="form-item__label">住址</text>
          <input class="form-item__input" placeholder="请输入住址" placeholder-class="input-placeholder" />
        </view>
      </view>
    </view>

    <!-- 3. 反面身份证卡片 -->
    <view class="upload-card-bottom">
      <view class="card-title">上传身份证反面(国徽面)</view>
      <view class="upload-area upload-area--back">
        <image class="upload-area__camera-icon" src="../../assets/image/idCardBack.png"></image>
      </view>
    </view>
  </view>

</view>