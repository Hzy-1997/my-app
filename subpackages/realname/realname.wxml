<view class="page-container upload-page">

  <!-- 1. 顶部提示 -->
  <view class="notice-bar">
    <text class="notice-bar__icon">!</text>
    <text class="notice-bar__text">请提交本人真实信息，否则使用功能存在缺失。</text>
  </view>

  <view class="card-box">
    <!-- 2. 正面身份证卡片 -->
    <view class="upload-card">
      <!-- 上传区域 -->
      <view class="upload-area-box">
        <view class="upload-card-box">
          <view class="card-title">上传身份证正面</view>
          <view class="upload-area upload-area--front" bind:tap="chooseImage" data-side="front">
            <image wx:if="{{frontImage}}" class="upload-area__camera-icon" src="../../assets/image/idCardFront.png"></image>
            <image wx:else class="upload-area__preview" src="{{frontImageUrl}}" mode="aspectFit"></image>
          </view>
        </view>

        <view class="upload-card-box">
          <view class="card-title">上传身份证反面</view>
          <view class="upload-area upload-area--back" bind:tap="chooseImage" data-side="back">
            <image wx:if="{{backImage}}" class="upload-area__camera-icon" src="../../assets/image/idCardBack.png"></image>
            <image wx:else class="upload-area__preview" src="{{backImageUrl}}" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <!-- 表单区域 -->
      <view class="form-area">
        <view class="form-item">
          <text class="form-label">姓名：</text>
          <input class="form-input" type="text" value="{{userName}}" placeholder="昵称" disabled bindinput="onNicknameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">身份证号：</text>
          <input class="form-input" type="text" value="{{idCard}}" placeholder="身份证号" disabled bindinput="onNicknameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">住址：</text>
          <input class="form-input" type="text" value="{{region}}" placeholder="住址" disabled bindinput="onNicknameInput" />
        </view>
      </view>
    </view>


    <view class="submit">
      <view class="submit-inner"  bind:tap="submit">提交</view>
    </view>
  </view>

</view>