<view class="page">
  <!-- Tab筛选 -->

  <view class="tabs-wrapper">
    <view wx:for="{{tabList}}" wx:key="index" class="tab-item {{currentTab === item.value ? 'active' : ''}}" bindtap="switchTab" data-value="{{item.value}}">
      {{item.label}}
      <view wx:if="{{currentTab === item.value}}" class="tab-line"></view>
    </view>
  </view>


  <!-- 订单列表 -->
  <view class="order-list">
    <view wx:for="{{orderList}}" wx:key="item" class="order-card">
      <view class="card-top">
        <view class="order-sn">订单号:{{item.orderNumber}}</view>
        <view class="status-tag status-{{item.payStatus}}">
          <view class="status-dot"></view>
          {{item.statusText}}
        </view>
      </view>
      <view class="card-body">
        <image class="goods-img" wx:if="{{value==1}}" src="{{gImgUrl+ item.ticket.homeImg}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==2}}" src="{{gImgUrl+ item.roomType.image}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==3}}" src="{{gImgUrl+ item.package.coverImage}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==4}}" src="{{gImgUrl+ item.campsite.image}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==5}}" src="{{gImgUrl+ item.ticket.homeImg}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==6}}" src="{{gImgUrl+ item.image}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==7}}" src="{{gImgUrl+ item.parking.image}}" mode="aspectFill"></image>
        <image class="goods-img" wx:if="{{value==8}}" src="{{gImgUrl+ item.ticket.homeImg}}" mode="aspectFill"></image>
        <view class="goods-info">
          <view class="goods-name">{{item.title}}</view>
          <view class="goods-time">{{item.createdAt}}</view>
        </view>
        <view class="goods-price">¥{{item.orderAmount}}</view>
      </view>
      <view class="card-bottom">
        <view wx:if="{{item.payStatus === 1}}" class="btn-row">
          <button class="btn-outline" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
          <button class="btn-solid" bindtap="goPay" data-id="{{item.id}}">去支付</button>
        </view>
        <view wx:else class="btn-row right">
          <button class="btn-solid" bindtap="goDetail" data-on="{{item.orderNumber}}">查看详情</button>
        </view>
      </view>
    </view>
    <view wx:if="{{orderList.length === 0}}" class="empty">暂无订单</view>
  </view>
</view>