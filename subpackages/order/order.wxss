page {
  background-color: #f7f8f9;
}
.page {
  padding: 30rpx;
  padding-top: 20rpx;
}
.tabs-wrap {
  white-space: nowrap;
  margin-bottom: 30rpx;
}
.tab-item {
  display: inline-block;
  font-size: 30rpx;
  color: #666;
  margin-right: 40rpx;
  padding-bottom: 12rpx;
  position: relative;
}
.tab-item.active {
  color: #08b8b0;
  font-weight: 500;
}
.tab-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background-color: #08b8b0;
  border-radius: 2rpx;
}
.order-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.order-sn {
  font-size: 28rpx;
  color: #666;
}
.status-tag {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}
.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.status-1 {
  color: #08b8b0;
}
.status-1 .status-dot {
  background-color: #08b8b0;
}
.status-2 {
  color: #08b8b0;
}
.status-2 .status-dot {
  background-color: #08b8b0;
}
.status-3 {
  color: #9b6ade;
}
.status-3 .status-dot {
  background-color: #9b6ade;
}
.status-4 {
  color: #9b6ade;
}
.status-4 .status-dot {
  background-color: #9b6ade;
}
.status-5 {
  color: #868686;
}
.status-5 .status-dot {
  background-color: #868686;
}
.card-body {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}
.goods-info {
  flex: 1;
}
.goods-name {
  display: block;
  font-size: 32rpx;
  color: #111;
  margin-bottom: 10rpx;
}
.goods-time {
  font-size: 26rpx;
  color: #888;
}
.goods-price {
  font-size: 34rpx;
  font-weight: 500;
  color: #111;
}
.btn-row {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}
.btn-row.right {
  justify-content: flex-end;
}
button {
  margin: 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
}
.btn-outline {
  background: #fff;
  color: #08b8b0;
  border: 1rpx solid #08b8b0;
}
.btn-solid {
  background-color: #08b8b0;
  color: #fff;
  border: none;
}
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
