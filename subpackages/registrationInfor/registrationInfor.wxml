<view class="page">
  <view class="orderInfo">
    <view>太舞滑雪冬令营</view>
    <view>地点 太舞滑雪小镇</view>
    <view>2026-12-13 00:00-23:59</view>
    <view>票档¥39400鹰果酒店标间中级1V3(早鸟价)x1套(共5张)</view>
  </view>
  <view class="participant-box">
    <view wx:for="{{ participants }}" wx:key="id" wx:for-item="p" wx:for-index="pIndex" class="participant-item">
      <view class="item-title">参与者 {{ p.id }}</view>
      <van-cell-group>
        <block wx:for="{{ fields }}" wx:key="key" wx:for-item="f">
          <!-- 普通输入 -->
          <van-field wx:if="{{ f.type === 'input' }}" value="{{ p[f.key] }}" label="{{ f.label }}" placeholder="{{ f.placeholder }}" border="{{ false }}" required="{{ f.required }}" error-message="{{ p.errors && p.errors[f.key] }}" data-index="{{ pIndex }}" data-field="{{ f.key }}" bind:change="onFieldChange" bind:blur="onFieldBlur" />
          <!-- 选择器 -->
          <van-field wx:elif="{{ f.type === 'picker' }}" value="{{ p[f.key] }}" label="{{ f.label }}" placeholder="{{ f.placeholder }}" border="{{ false }}" readonly is-link required="{{ f.required }}" error-message="{{ p.errors && p.errors[f.key] }}" data-index="{{ pIndex }}" data-field="{{ f.key }}" data-options="{{f.options}}" bind:tap="onOpenPicker" />
          <!-- 多行文本 -->
          <van-field wx:elif="{{ f.type === 'textarea' }}" value="{{ p[f.key] }}" label="{{ f.label }}" placeholder="{{ f.placeholder }}" border="{{ false }}" type="textarea" autosize required="{{ f.required }}" error-message="{{ p.errors && p.errors[f.key] }}" data-index="{{ pIndex }}" data-field="{{ f.key }}" bind:change="onFieldChange" bind:blur="onFieldBlur" />

        </block>
      </van-cell-group>
    </view>

  </view>

  <!-- 选择器弹层（全局只用一个） -->
  <van-popup show="{{ showPicker }}" position="bottom" bind:close="onClosePicker">
    <van-picker show-toolbar columns="{{ currentOptions }}" bind:confirm="onPickerConfirm" bind:cancel="onClosePicker" />
  </van-popup>


  <view class="submit">
    <view class="submitPice">
      <view>¥<text style="font-size: 38rpx;">4399</text> </view>
      <view>¥4899</view>
    </view>
    <view class="btn" bind:tap="determine">确 定</view>
  </view>
</view>