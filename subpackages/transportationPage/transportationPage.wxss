/* 全局背景与字体 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background-color: #c4e6d1;
}

.page {
  padding: 60rpx 30rpx 100rpx;

}

/* ================= 头部深绿色区域 ================= */
.header {
  background-color: #1B653F;
  /* 深墨绿色 */
  padding: 60rpx 40rpx 100rpx;
  /* 底部留出大 padding 给 content 遮盖 */
  position: relative;
  overflow: hidden;
  border-radius: 40rpx 40rpx 0rpx 0rpx;
}

/* 右上角三角形装饰 */
.mountain-icon {
  position: absolute;
  top: 50rpx;
  right: 40rpx;
  width: 0;
  height: 0;
  border-left: 40rpx solid transparent;
  border-right: 40rpx solid transparent;
  border-bottom: 60rpx solid rgba(255, 255, 255, 0.15);
}

.header-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 4rpx;
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #ffffff;
}

.desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.wave-container {
  background: cornflowerblue;
  height: 80rpx;
}

.wave-container image {
  width: 100%;
  height: 100%;
}



/* ================= 内容区（波浪覆盖） ================= */
.content {
  /* 关键：向上覆盖，形成波浪弧度的视觉 */
  position: relative;
  z-index: 10;
  background: #ffff;
  border-radius: 0rpx 0rpx 40rpx 40rpx;


}

/* ================= 通用卡片样式 ================= */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  /* 极淡的阴影 */
}

/* 卡片头部（图标+标题+右侧图标） */
.card-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

/* 数字图标 01-05 */
.icon-num {
  background: #E8F5E9;
  /* 浅绿色背景 */
  color: #145A3E;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}

.card-sub {
  font-size: 24rpx;
  color: #888;
}

/* 右侧小图标 */
.icon-car,
.icon-plane,
.icon-train,
.icon-bus,
.icon-shuttle {
  font-size: 36rpx;
  opacity: 0.8;
}

/* ================= 图片占位区 ================= */
.image-placeholder {
  width: 100%;
  height: 120rpx;
  /* 小图高度 */
  background: #F8F9FA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.image-placeholder.large-placeholder {
  height: 300rpx;
  /* 长图高度 */
}

.placeholder-img {
  width: 100%;
  height: 100%;
  /* 未设置 src 时，小程序会显示默认占位图，或者你可以放个背景色 */
}

/* ================= 路线盒子（浅灰色） ================= */
.route-box {
  background: #F9FAFA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.route-box:last-child {
  margin-bottom: 0;
}

.route-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.route-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
}

/* 时间标签胶囊 */
.time-tag {
  background: #E8F5E9;
  color: #145A3E;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

/* 路线详情行 */
.route-detail {
  font-size: 24rpx;
  color: #555;
  margin-top: 10rpx;
  line-height: 1.5;
  display: flex;
}

.route-detail.no-label {
  display: block;
  color: #666;
}

.label {
  color: #999;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* ================= 纯文本区域 ================= */
.plain-text {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  margin-top: 10rpx;
}

/* ================= A/B 线特殊样式 ================= */
.special-route {
  background: #ffffff;
  /* A/B 线是白底卡片 */
  border: 1rpx solid #EEEEEE;
}

.icon-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.icon-a {
  background: #4CAF50;
  /* 绿色 */
  color: #ffffff;
}

.icon-b {
  background: #2E7D32;
  /* 深绿色 */
  color: #ffffff;
}

/* ================= 底部徽章 ================= */
.badge-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.badge {
  background: #E8F5E9;
  color: #145A3E;
  font-size: 24rpx;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-weight: 500;
}

.badge-icon {
  font-size: 28rpx;
}

/* ================= 底部 Footer ================= */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  gap: 12rpx;
  border-radius: 0rpx 0rpx 40rpx 40rpx;
}

.footer-icon {
  font-size: 40rpx;
}

.footer-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #145A3E;
}

.footer-sub {
  font-size: 24rpx;
  color: #888;
}