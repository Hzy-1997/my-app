<view>
  <view class="box">
    <scroll-view scroll-y class="scroll-wrap">
      <!-- 状态卡片 -->
      <view class="order-card">
        <view class="card-top">
          <text class="order-sn">预订订单号：{{detail.orderNo}}</text>
          <view class="status-tag status-{{detail.status}}">
            <view class="status-dot"></view>
            {{detail.statusText}}
          </view>
        </view>
        <view class="card-body">
          <image class="goods-img" src="{{detail.cover}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{detail.goodsName}}</text>
            <text class="goods-time">下单时间：{{detail.createTime}}</text>
          </view>
          <text class="goods-price">¥{{detail.amount}}</text>
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="info-card">
        <view class="info-title">订单信息</view>
        <view class="info-row">
          <text class="label">支付时间</text>
          <text class="value">{{detail.payTime || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">支付方式</text>
          <text class="value">{{detail.payWay || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="label">实付金额</text>
          <text class="value price">¥{{detail.amount}}</text>
        </view>
      </view>

      <!-- 核销信息（已支付/已完成才显示） -->
      <view class="info-card" wx:if="{{detail.status === 2 || detail.status ===3}}">
        <view class="info-title">核销信息</view>
        <view class="info-row">
          <text class="label">核销码</text>
          <text class="value">{{detail.verifyCode}}</text>
        </view>
        <view class="info-row">
          <text class="label">有效期</text>
          <text class="value">{{detail.validDate}}</text>
        </view>
      </view>

      <!-- 退款信息 -->
      <view class="info-card" wx:if="{{detail.status === 4}}">
        <view class="info-title">退款信息</view>
        <view class="info-row">
          <text class="label">退款时间</text>
          <text class="value">{{detail.refundTime}}</text>
        </view>
        <view class="info-row">
          <text class="label">退款原因</text>
          <text class="value">{{detail.refundReason}}</text>
        </view>
      </view>

      <!-- ✅ 新增：使用说明（适合景区年卡） -->
      <view class="info-card tips-card" wx:if="{{detail.status === 2 || detail.status ===3}}">
        <view class="info-title">使用说明</view>
        <view class="tips-item">• 入园请出示核销码，一人一卡，仅限本人使用</view>
        <view class="tips-item">• 年卡有效期内不限次数入园，不含景区二次消费项目</view>
        <view class="tips-item">• 年卡一经核销，不支持退款；未核销可按规则申请退款</view>
        <view class="tips-item">• 景区开放时间以官方公告为准，恶劣天气会临时闭园</view>
      </view>

      <view class="spacer"></view>
    </scroll-view>
    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <view class="btn-row">
        <button wx:if="{{detail.status === 1}}" class="btn-outline" bindtap="cancelOrder">取消订单</button>
        <button wx:if="{{detail.status === 1}}" class="btn-solid" bindtap="goPay">去支付</button>
        <button wx:if="{{detail.status === 2}}" class="btn-outline" bindtap="applyRefund">申请退款</button>
        <button class="btn-solid" bindtap="backList">返回订单列表</button>
      </view>
    </view>
  </view>
</view>