page {
  background-color: #f7f8f9;
}


.box {
  width: 100vw;
  height: 100vh;
  border: 1px solid;
}

.scroll-wrap {
  flex: 1;
  padding: 30rpx;
}

.spacer {
  height: 140rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.order-sn {
  font-size: 28rpx;
  color: #666;
}

.status-tag {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-1 {
  color: #08b8b0;
}

.status-1 .status-dot {
  background-color: #08b8b0;
}

.status-2 {
  color: #08b8b0;
}

.status-2 .status-dot {
  background-color: #08b8b0;
}

.status-3 {
  color: #9b6ade;
}

.status-3 .status-dot {
  background-color: #9b6ade;
}

.status-4 {
  color: #9b6ade;
}

.status-4 .status-dot {
  background-color: #9b6ade;
}

.status-5 {
  color: #868686;
}

.status-5 .status-dot {
  background-color: #868686;
}

.card-body {
  display: flex;
  align-items: center;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
}

.goods-info {
  flex: 1;
}

.goods-name {
  display: block;
  font-size: 32rpx;
  color: #111;
  margin-bottom: 10rpx;
}

.goods-time {
  font-size: 26rpx;
  color: #888;
}

.goods-price {
  font-size: 34rpx;
  font-weight: 500;
  color: #111;
}

.info-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.info-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #111;
}

.value.price {
  color: #ef4444;
}

.bottom-bar {
  width: 100%;
  background-color: #fff;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  justify-content: flex-end;
}

button {
  margin: 0;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.btn-outline {
  background: #fff;
  color: #08b8b0;
  border: 1rpx solid #08b8b0;
}

.btn-solid {
  background-color: #08b8b0;
  color: #fff;
  border: none;
}

.tips-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}