page {
  background: #EFEEEA;
}

.page-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
}

.hero-banner {
  width: 100%;
  height: 450rpx;
}

.hero-banner image {
  width: 100%;
  height: 100%;
  display: block;
}

.info-card {
  margin-top: -150rpx;
  padding: 0rpx 30rpx;
  position: relative;

}

.welcome-section {
  background: #FFF5EC;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 20rpx;

}

.welcome-section__title {
  color: #284842;
  font-size: 35rpx;
  font-weight: 600;
  margin-bottom: 15rpx;

}

.welcome-section__desc {
  color: #25211D;
  text-indent: 2em;
  font-size: 28rpx;
}

.overview-section {
  margin-top: 20rpx;
  padding: 20rpx 20rpx;
  background: #ffff;
  border-radius: 20rpx;
  /* display: flex;
  flex-direction: column;
  align-items: center; */
}

.section-title {
  display: flex;
  align-items: center;
}

.section-title view:nth-child(1) {
  color: #284842;
  font-size: 35rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
}

.section-title view:nth-child(2) {
  width: 50rpx;
  height: 5rpx;
  background: #284842;
  margin-left: 10rpx;
}





.overview-section__desc {
  color: #25211D;
  text-indent: 2em;
  font-size: 28rpx;
}

.tag-group {
  width: 100%;
  height: 200rpx;
  margin-top: 10rpx;
}

.tag-group image {
  width: 100%;
  height: 100%;
}

.contact-section {
  margin-top: 20rpx;
  padding: 20rpx 20rpx;
  background: #ffff;
  border-radius: 20rpx;
}

.contact-section-title {
  /* width: 139rpx; */
  color: #284842;
  font-size: 35rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
}

.contact-list {
  color: #284842;
}

.page-footer {
  width: 100%;
  /* 删掉 height: 100%; 给它一个具体的固定高度 */
  /* 适配 iPhone 底部安全区 */
  /* padding-bottom: env(safe-area-inset-bottom); */
  padding-bottom: 20rpx;
  background-color: #194D4B;
  /* 必须给背景色，否则下面的内容会透上来 */
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 9999;
  /* 把 z-index 调高，防止被 info-card 遮挡 */
  /* 建议去掉 border，或者换成 border-top: 1px solid #eee; */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
  color: #fff;
}

/* 2. 根据你截图的UI调整内部布局 */
.footer-socials {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  /* 两个图标之间的间距 */
  /* margin-bottom: 20rpx; */
}

.footer-socials__item {
  /* 你原来的 height: 180rpx; 太夸张了，图标不需要这么高 */
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 假设底部背景是深色，字体用白色 */
  font-size: 24rpx;
}

.footer-socials__item {
  width: 120rpx;
  height: 120rpx;
  background: #fff;

}

.footer-socials__icon {
  width: 100rpx;
  height: 100rpx;
}

.footer-socials__text {
  color: #000;
  font-weight: 600;
}

.footer-copyright {
  font-size: 24rpx;
}