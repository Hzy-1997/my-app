/* subpackages/licensePlate/licensePlate.wxss */

.page {
  padding: 0rpx 30rpx;
}

.content {
  margin-top: 100rpx;
  border-radius: 20rpx;
  padding: 0rpx 10rpx;
  background: #ffff;
}

.title {
  font-size: 36rpx;
  font-weight: 900;
}

.input-number-box {
  display: flex;
}

.input-number {
  width: 130rpx;
  height: 100rpx;
  border: 1rpx solid #d1cece;
  margin-top: 30rpx;
  margin-right: 8rpx;
  border-radius: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  font-weight: 600;
}

.textEnergy {
  text-align: center;
  font-size: 20rpx;
}


.input-number:nth-child(2) {
  margin-right: 30rpx;
  position: relative;
}

.input-number:nth-child(2)::after {
  position: absolute;
  content: "";
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: black;
  top: 50%;
  transform: translateY(-50%);
  right: -20rpx;
}

.input-number:last-child {
  margin-right: 0;

  font-weight: 600;
  color: #44C75F;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #44C75F;
}

.action {
  border: 2px solid green !important;
}

.history-number {
  margin-top: 20rpx;
  padding: 5rpx;
  font-size: 26rpx;
  border: 1px solid;
  width: 160rpx;
  text-align: center;
  border-radius: 10rpx;
  border: 1rpx solid #d1cece;
}


.btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 100rpx;
}

.submit {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  background: #21774A;
  text-align: center;
  line-height: 100rpx;
  color: #fff;
  font-size: 38rpx;
}

.hint {
  margin-top: 100rpx;
  color: darkgrey;
  font-size: 30rpx;

}

.numericKeypad {
  width: 100%;
  min-height: 450rpx;
  border-top: 1px solid #ccc;
  position: fixed;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 8rpx;
  padding: 10rpx 8rpx 50rpx;
  background: #CED4DB;
  box-sizing: border-box;
  z-index: 999;
}


.Keypad {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 10rpx;
  box-sizing: border-box;
  background: #fff;
}

.Keypad-disabled {
  background: #e5e5e5 !important;
  color: #bbb !important;
  pointer-events: none;
  /* 鼠标/触摸事件穿透，彻底不可点 */
}