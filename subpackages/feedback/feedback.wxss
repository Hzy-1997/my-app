/* feedback.wxss */
page {
  background-color: #ffffff;
}

.container {
  background: #fff;
}

/* 内容容器 */
.content {
  padding: 30rpx;
}

/* 通用表单项 */
.form-item {
  margin-bottom: 40rpx;
}


.section {
  margin: 60rpx 0rpx 40rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
}


.border-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}


.label {
  font-weight: 600;
}

.label-row {
  display: flex;
  align-items: baseline;
  margin: 30rpx 0rpx 30rpx 10rpx;
}

.label-bold {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.sub-label {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.required {
  color: #ff4d4f;
  margin-right: 4rpx;
}



.placeholder {
  color: #ccc;
}

/* 文本域 */
.textarea-box {
  margin-top: 20rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
}

.textarea {
  width: 100%;
  height: 300rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.placeholder-text {
  color: #999;
}

.word-count {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* 上传附件 */
.upload-area {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.upload-btn {
  width: 140rpx;
  height: 140rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
}

.camera-icon {
  font-size: 40rpx;
  color: #999;
}

.upload-tip {
  font-size: 24rpx;
  color: #999;
}

.img-item {
  width: 140rpx;
  height: 140rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.img-item image {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  width: 36rpx;
  height: 36rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

/* 联系方式输入框 */
.input-box {
  background: #f7f8fa;
  border-radius: 30rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 30rpx;
  width: 80rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.phone-box {
  padding-left: 0;
}

.area-code {
  font-size: 28rpx;
  color: #333;
  padding: 0 30rpx;
  border-right: 1rpx solid #ddd;
  margin-right: 30rpx;
}

.phone-input {
  color: #333;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 30rpx 40rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 99;
}

.submit-btn {
  background-color: #1989fa;
  /* 这里可以换成设计图的主色，通常是橙色或蓝色 */
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 10rpx 0;
}


.popup-box {
  height: 1200rpx;
  border: 1px solid;
}

.country-picker {
  display: flex;
  flex-direction: column;
  height: 75vh;
  /* 弹窗高度，可根据需要调整 */
  background: #fff;
}

/* 头部样式 */
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  position: relative;
  border-bottom: 1px solid #f5f5f5;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-left: 20px;
  /* 为了让标题完全居中，抵消右侧图标的宽度 */
}

/* 主体内容 */
.picker-body {
  flex: 1;
  display: flex;
  overflow: hidden;
  position: relative;
}

/* 左侧列表 */
.list-scroll {
  flex: 1;
  height: 100%;
}

.group-letter {
  background: #f5f6f8;
  padding: 4px 20px;
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.country-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 20px;
  border-bottom: 1px solid #f5f5f5;
  font-size: 15px;
  color: #333;
}

.country-code {
  color: #999;
  font-size: 14px;
}

/* 右侧字母索引 */
.index-bar {
  width: 26px;
  /* 稍微收窄一点 */
  height: 100%;
  /* 填满父容器高度 */
  display: flex;
  flex-direction: column;
  justify-content: center;
  /* 垂直居中 */
  align-items: center;
  padding: 5px 0;
  background: #fff;
  box-sizing: border-box;
}

.index-item {
  font-size: 11px;
  color: #333;
  flex: 1;
  /* 关键：让26个字母自动均分整个高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  margin: 1px 0;
  border-radius: 50%;
  transition: all 0.1s;
}

.index-item.active {
  color: #fff;
  background-color: #1989fa;
  font-weight: bold;
}

.index-item.disabled {
  color: #ccc;
  opacity: 0.5;
  /* 让没数据的字母更淡一些 */
}