/* components/nav-bar/nav-bar.wxss */

/* 整个顶部区域容器 */
.page-header {
  width: 100%;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
}

/* 导航栏主体 */
.top-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center; /* 标题居中 */
  position: relative; /* 为绝对定位的返回按钮提供参考 */
  box-sizing: border-box;
  transition: background-color 0.3s ease; /* 平滑过渡效果 */
}

/* 返回按钮 - 绝对定位在左侧 */
.back-btn {
  position: absolute;
  left: -10rpx;
  bottom: 0;
  height: 88rpx; /* 与胶囊按钮高度相近 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  z-index: 10;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
}

/* 标题样式 */
.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  max-width: 60%; /* 防止标题过长遮挡按钮 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
