/* pages/userInformation/userInformation.wxss */


.member-center {
  padding: 10rpx 20rpx 0rpx;
  height: 100vh;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.member-header {
  height: 150rpx;
  border-radius: 20rpx 20rpx 0rpx 0rpx;
  padding: 20rpx;
  background: #FBF5EA;

}

.member-header_bx {
  height: 100%;
  display: flex;
  position: relative;
  align-items: center;
}

.member-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.member-avatar image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.member-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 20rpx;
}

.member-info_name {
  font-weight: 600;
  font-size: 36rpx;
}

.member-info_card {
  margin-top: 10rpx;
  font-size: 25rpx;
}

.qrCode {
  position: absolute;
  right: 30rpx;
}

.assets-grid {
  height: 100rpx;
  border-radius: 0rpx 0rpx 20rpx 20rpx;
  display: grid;
  grid-template-columns: auto auto auto auto;
  align-content: center;
  background: #1B7071;
}

.assets-grid_item {
  height: 100rpx;
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
}


.order-box {
  background: #fff;
  border-radius: 20rpx;
  margin-top: 30rpx;
}

.order-title-box {
  padding: 10rpx 35rpx 0rpx;
}

.order-title {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;

}

.order-title text:nth-child(2) {
  margin: 0rpx 20rpx;
}

/* 画右侧的长线 */
.order-title::after {
  content: '';
  display: block;
  flex: 1;
  height: 3rpx;
  background-color: #C4A57B;
}


.order-grid {
  height: 300rpx;
  border-radius: 20rpx;
  display: grid;
  grid-template-columns: auto auto auto auto;
}

.order-grid_item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.order-grid_item_icon {
  width: 60rpx;
  height: 60rpx;
  text-align: center;
  line-height: 80rpx;
  padding: 10rpx;
  background: #FEF6EA;
  border-radius: 10rpx;
  margin-bottom: 5rpx;
}

.order-grid_item_icon image {
  width: 100%;
  height: 100%;
}

.order-grid_item_text {
  font-size: 25rpx;
}


.service {
  margin: 30rpx 0rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0rpx 30rpx;
}

.service_left {
  display: flex;
  align-items: center;
  justify-content: center;
}



.settings {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-bottom: 30rpx;
  background: #fff;
}

.settings_box {
  display: flex;
  align-items: center;
  height: 95rpx;
  padding: 10rpx 30rpx;
  justify-content: space-between;
}

.settings_box_left {
  display: flex;
}

.settings_icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.settings_icon image {
  width: 100%;
  height: 100%;
}