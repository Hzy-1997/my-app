.image-name {
  padding: 20rpx;
}

.image-title {
  font-size: 32rpx;
  font-weight: 900;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}