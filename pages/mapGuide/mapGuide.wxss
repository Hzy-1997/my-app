/* pages/mapGuide/mapGuide.wxss */

/* 页面容器设置相对定位 */
.map-container {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.filter-bar {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 99;

  display: flex;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  padding: 10rpx 0;
  border-radius: 30rpx;
}

.filter-item.active {
  background-color: #007aff;
  color: #fff;
}

.navbar {
  width: 101vw;
  height: 120rpx;
  white-space: nowrap;
  background: #458c8d;
}

.nav-inner {
  position: relative;
  display: flex;
  height: 100%;
  flex-shrink: 0;
}

.top-menu {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 120rpx;
  height: 120rpx;
  margin: 0 10rpx;
  line-height: 1;
}

.icon-nav-list {
  margin-bottom: 15rpx;
}

.icon-nav-text {
  margin-bottom: 15rpx;
}

.tabs-line {
  position: absolute;
  left: 0;
  bottom: 10rpx;
  width: 80rpx;
  height: 6rpx;
  background-color: #fff;
  border-radius: 3rpx;
  transition: transform 0.3s cubic-bezier(0.65, 0.15, 0.35, 1);
  z-index: 1;
}