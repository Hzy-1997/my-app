
<view class="map-container">
  <scroll-view class="navbar" scroll-x="true" enable-flex="true" scroll-left="{{scrollLeft}}" scroll-with-animation="true" bindscroll="onNavbarScroll">
    <view class="nav-inner">
      <view class="top-menu {{isActive === item.id ? 'active' : ''}}" wx:for="{{topMenuList}}" wx:key="id" bind:tap="menuType" data-type="{{item.id}}" data-index="{{index}}">
        <view class="icon-nav-list">{{isActive === item.id ? item.selectedIcon : item.icon}}</view>
        <view class="icon-nav-text">{{item.title}}</view>
      </view>
 
      <view class="tabs-line" style="transform: translateX({{lineOffset}}px)"></view>
    </view>
  </scroll-view>


  <map id="showMap" longitude="{{longitude}}" latitude="{{latitude}}" scale="{{scale}}" markers="{{markers}}" polygons="{{polygons}}" bindmarkertap="onMarkerTap" bindregionchange="onRegionChange" show-location style="width: 100%; height: 100%;">
  </map>
</view>