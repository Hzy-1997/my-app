/* pages/performance/performance.wxss */

.body {
  padding: 0rpx 20rpx;
  background: linear-gradient(to bottom, #803728 0%, #8f4031 20%, #EEDED1 50%, #EEDED1 100%);
  min-height: 100vh;
}

.head {
  width: 100%;
  padding-top: 200rpx;
}

.banner-bg {
  height: 380rpx;
  border-radius: 15rpx;
  border: 1px solid;
}

.scrollBox {
  margin-top: 40rpx;
}

.scrollBoxTitle {
  margin: 10rpx 0rpx;
  font-weight: 600;
  font-size: 36rpx;

}

.card-list {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: max-content;
  padding: 20rpx 0rpx;
}

.show-card {
  flex-shrink: 0;
  width: 190rpx;
  margin-right: 20rpx;
  background: #21211F;
  border-radius: 12rpx;
}

.show-card:last-child {
  margin-right: 0;
}

.card-coverBox {
  width: 100%;
  height: 150rpx;
  border-radius: 10rpx 10rpx 0rpx 0rpx;
  background: #fff;
  border-radius: 12rpx;
}

.card-info {
  padding: 10rpx;
  color: #ffff;
  border-radius: 0rpx 0rpx 10rpx 10rpx;
}

.card-name {
  font-weight: 600;
}

.card-tag {
  font-size: 26rpx;
  width: 100rpx;
  padding: 2rpx 8rpx;
  border-radius: 15rpx;
  background: #9A612C;
  margin: 10rpx 0rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.card-time {
  font-size: 26rpx;
}



.stats-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 0rpx;
}

.stats-card {
  width: 340rpx;
  height: 150rpx;
  border: 1px solid;
  border-radius: 20rpx;
  color: #FAEDC6;
  background: #322E2D;

}

.stats-title {
  margin: 20rpx 0rpx 0rpx 20rpx;
  font-size: 35rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.stats-desc {
  margin: 0rpx 0rpx 0rpx 20rpx;
  font-size: 26rpx;
}

.stats-card-gold {
  background: #AD7844;
}

.perform-section {
  padding: 15rpx;
  background: #F7E6DC;
  box-shadow: 0 8rpx 24rpx rgba(139, 90, 43, 0.08);
  border-radius: 20rpx;
  margin: 40rpx 0rpx;
}

.perform-header {
  margin-bottom: 20rpx;
}

.perform-title {
  font-size: 40rpx;
  font-weight: 600;
}

.perform-subtitle {
  color: #A86C36;
}

.perform-card-list {
  display: flex;
  justify-content: space-between;
}

.perform-card {
  border: none;
  width: 295rpx;
  border-radius: 15rpx;
  background-color: #F8EADF;
  box-shadow: 0 8rpx 24rpx rgba(139, 90, 43, 0.08);
  padding: 20rpx;
}

.card-title {
  font-weight: 600;
}

.card-desc {
  font-size: 26rpx;
  margin: 8rpx 0rpx;

}

.perform-card .card-tag {
  background: #C48447;
  font-weight: 400;
  color: #fff;
  width: 150rpx;
}