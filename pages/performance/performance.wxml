<view class="body">
  <!-- 自定义顶部导航栏 -->
  <nav-bar id="nav-bar" title="{{navTitle}}" always-show-title="{{true}}" styleShowColor="{{true}}" />

  <view class="head">
    <view class="banner-bg">
      <!-- <image class="banner-ig" src="..." mode="aspectFill" /> -->
    </view>
  </view>

  <view class="scrollBox">
    <view class="scrollBoxTitle">特色王牌演出</view>
    <scroll-view class="card-scroll" scroll-x="true" style="width: 100%">
      <view class="card-list">
        <view class="show-card" wx:for="{{acePerformance}}" wx:key="item">
          <view class="card-coverBox">
            <!-- <image class="card-cover" src="..." mode="aspectFill" /> -->
          </view>
          <view class="card-info">
            <view class="card-name">{{item}}</view>
            <view class="card-tag">王牌演出</view>
            <view class="card-time">19:00开演</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="stats-box">
    <!-- 左侧深色卡片 -->
    <view class="stats-card stats-card-dark">
      <view class="stats-title">经典演出</view>
      <view class="stats-desc">
        <view class="icon-play"></view>
        <view>约出x0歌谣汇</view>
      </view>
      <!-- <image class="stats-bg-icon" src="..." /> -->
    </view>
    <!-- 右侧金色卡片 -->
    <view class="stats-card stats-card-gold">
      <view class="stats-title">互动演出</view>
      <view class="stats-desc">
        <view class="icon-play"></view>
        <view>今日个互动演出</view>
      </view>
      <!-- <image class="stats-bg-icon" src="..." /> -->
    </view>
  </view>

  <view class="perform-section">
    <!-- 头部标题 -->
    <view class="perform-header">
      <view class="perform-title">光雾山演艺看点</view>
      <view class="perform-subtitle">发现值得看的巴山故事</view>
    </view>

    <!-- 卡片列表 (使用 Flex 布局) -->
    <view class="perform-card-list">
      <!-- 左侧卡片 -->
      <view class="perform-card" bind:tap="goPopular">
        <view class="card-title">红叶山里的红色记忆</view>
        <view class="card-desc">从红军歌谣到山水舞台，感受巴中独特的演艺气质</view>
        <view class="card-tag tag-hot">热门看点>></view>
      </view>

      <!-- 右侧卡片 -->
      <view class="perform-card" bind:tap="goInteraction">
        <view class="card-title">互动演出怎么玩</view>
        <view class="card-desc">扫码参与、亲子任务、夜游互动，让游览更有代入感</view>
        <view class="card-tag tag-guide">互动指南>></view>
      </view>
    </view>
  </view>


</view>