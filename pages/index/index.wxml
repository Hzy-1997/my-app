<view>
  <view class="page-header">
    <view class="top-bar" style="background-color: {{headerBgColor}};">111</view>
    111111
  </view>

  <view class="nav-tabs">
    <view class="grid-container">
      <view class="nav-tabs_item" wx:for="{{navMenu}}" wx:key="item" bindtap="onTopRowClick" data-num="{{item.id}}" data-item="{{item}}">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="func-grid">
    <view class="grid-container">
      <view class="grid-item" wx:for="{{categoryMenu}}" wx:key="item" bindtap="onBottomRowClick" data-num="{{item.id}}" data-item="{{item}}">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-name">{{item.name}}</view>
      </view>
    </view>
  </view>


  <view class="bottom-display">
    <!-- 酒店 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title">酒店</view>
        <view class="section-more" bindtap="toHotel" data-link="/guides">查看更多 ></view>
      </view>
      <view class="swiper-guide">
        <swiper class="swiper" bindchange="onSwiperChange" circular autoplay="{{true}}" interval="{{2000}}" duration="{{500}}">
          <block wx:for="{{hotelList}}" wx:key="item">
            <swiper-item>
              <view class="swiper-item" bindtap="goRoomType" data-id="{{item.id}}">
                <image class="img" src="{{gImgUrl}}{{item.images}}" mode="" />
                <view class="title">{{item.title}}</view>
              </view>
            </swiper-item>
          </block>
        </swiper>
        <!-- 自定义指示点 -->
        <view class="custom-indicator">
          <view class="dot {{currentIndex === index ? 'active' : ''}}" wx:for="{{5}}" wx:key="index">
          </view>
        </view>
      </view>
    </view>
    <!-- 攻略 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title">攻略笔记</view>
        <view class="section-more" bindtap="toStrategy" data-link="/guides">查看更多 ></view>
      </view>
      <view class="swiper-guide">
        <scroll-view class="scroll-view_H" scroll-x="true" style="width: 100%">
          <view class="scroll-view_box">
            <view id="demo1" class="scroll-view-item_H demo-text-1" wx:for="{{strategyList}}" wx:key="item" bindtap="goDetails" data-id="{{item.id}}">
              <view class="guide-image">
                <image class="img" src="{{gImgUrl}}{{item.cover}}" mode="" />
              </view>
              <view class="guide-info">{{item.title}}</view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
  <!-- 票务 -->
  <view class="product">
    <view class="section-header">
      <view class="section-title">产品推荐</view>
      <view class="section-more" bindtap="toModule" data-link="/guides">查看更多 ></view>
    </view>
    <view class="product-box">
      <view class="product-card" wx:for="{{tickeList}}" wx:key="item" bindtap="purchase" data-id="{{item.id}}">
        <view class="product-image">
          <image class="img" src="{{gImgUrl}}{{item.homeImg}}" mode="" />
        </view>
        <view class="product-name">{{item.title}}</view>
        <view class="product-info">
          <view class="product-type">¥{{item.originalPrice}}</view>
          <view class="product-price-row">
            <view class="product-sold">已售21414+</view>
            <view class="product-price">
              <view> <text class="price-symbol">¥</text>
                <text class="price-value">{{item.discountPrice}}</text>
                <text class="price-unit">起</text>
              </view>
            </view>
          </view>
        </view>

      </view>


    </view>
  </view>

</view>