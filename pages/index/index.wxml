<view>
  <view class="page-header">
    <view class="top-bar" style="background-color: {{headerBgColor}};">111</view>
    111111
  </view>

  <view class="nav-tabs">
    <view class="grid-container">
      <view class="nav-tabs_item" wx:for="{{navMenu}}" wx:key="item">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="func-grid">
    <view class="grid-container">
      <view class="grid-item" wx:for="{{categoryMenu}}" wx:key="item">
        <view class="item-icon">{{item.icon}}</view>
        <view class="item-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-display">
    <view class="section">
      <view class="section-header">
        <view class="section-title">酒店</view>
        <view class="section-more" bindtap="onMoreTap" data-link="/guides">查看更多 ></view>
      </view>
      <view class="swiper-guide">
        <swiper class="swiper" bindchange="onSwiperChange" circular autoplay="{{true}}" interval="{{2000}}" duration="{{500}}">
          <block wx:for="{{background}}" wx:key="*this">
            <swiper-item>
              <view class="swiper-item {{item}}">{{item}}</view>
            </swiper-item>
          </block>
        </swiper>
        <!-- 自定义指示点 -->
        <view class="custom-indicator">
          <view class="dot {{currentIndex === index ? 'active' : ''}}" wx:for="{{5}}" wx:key="index">
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <view class="section-title">攻略笔记</view>
        <view class="section-more" bindtap="onMoreTap" data-link="/guides">查看更多 ></view>
      </view>
