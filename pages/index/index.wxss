.top-bar {
  position: fixed;
  top: 0rpx;
}

.page-header {
  width: 100%;
  height: 500rpx;
  border: 1px solid;
}

.top-bar {
  width: 100%;
  height: 180rpx;
  border: 1px solid;
}

.nav-tabs {
  /* width: 100%; */
  height: 200rpx;
  /* border: 1px solid; */
  padding: 0rpx 20rpx;
  background: #ffff;
}

.grid-container {
  height: 100%;
  display: grid;
  grid-template-columns: auto auto auto auto auto;
  grid-column-gap: 20px;
  /* border: 1px solid; */

}

.nav-tabs_item {
  background: #ffff;
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item-icon {
  width: 100%;
  height: 100rpx;
  font-size: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item-name {
  font-size: 25rpx;
}

.func-grid {
  height: 350rpx;
  background: #ffff;
  margin: 20rpx 0rpx 20rpx;
  padding: 20rpx 20rpx;
}

.grid-item {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

}

.bottom-display {
  background: #ffff;
  min-height: 700rpx;
  border: 1px solid;
  padding: 0rpx 30rpx;
}

.section {
  background-color: #ffffff;
  height: 500rpx;
  margin-top: 16rpx;
  /* padding: 32rpx 0 40rpx; */
  border: 1px solid;
  /* border-radius: 20rpx; */
  border-radius: 20rpx 20rpx 0rpx 0rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0rpx 15rpx;
  margin-bottom: 32rpx;
  /* border: 1px solid; */
  height: 80rpx;
  border-radius: 20rpx 20rpx 0rpx 0rpx;

}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  position: relative;
  padding-left: 16rpx;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}