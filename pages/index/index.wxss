.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 99;
  /* 宽度默认100%，不需要设置 */
}

.top-bar-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-left: 30rpx;
}

.title-text {
  font-weight: 900;
  font-size: 36rpx;
}


.page-header {
  width: 100%;
  height: 500rpx;
  background: coral;
}

.top-bar {
  width: 100%;
  height: 180rpx;
}

.nav-tabs {
  /* width: 100%; */
  height: 200rpx;
  padding: 0rpx 20rpx;
  background: #ffff;
}

.grid-container {
  height: 100%;
  display: grid;
  grid-template-columns: auto auto auto auto auto;
  grid-column-gap: 20px;

}

.nav-tabs_item {
  background: #ffff;
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.item-icon {
  width: 100%;
  height: 100rpx;
  font-size: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item-name {
  font-size: 25rpx;
}

.func-grid {
  height: 350rpx;
  background: #ffff;
  margin: 20rpx 0rpx 20rpx;
  padding: 20rpx 20rpx;
}

.grid-item {
  width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

}

.bottom-display {
  background: #ffff;
  min-height: 700rpx;
  padding: 30rpx 30rpx 10rpx;
}

.section {
  margin-bottom: 20rpx;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.2);
  border-radius: 15rpx;

}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-radius: 15rpx 15rpx 0rpx 0rpx;
  padding: 0rpx 20rpx;
  margin-bottom: 10rpx;

}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  position: relative;
}

.section-more {
  font-size: 26rpx;
  color: #999999;
}

.swiper-guide {
  height: 440rpx;
  position: relative;
}

.swiper {
  height: 440rpx;
}

.swiper-item {
  height: 100%;
  position: relative;
}

.swiper-item .img {
  width: 100%;
  height: 100%;
}

.swiper-item .title {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
}

.custom-indicator {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 198rpx;
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
  background: #999999;
}

.dot {
  width: 30rpx;
  height: 6rpx;
  border-radius: 3rpx;
  transition: all 0.5s;
}

.dot.active {
  width: 60rpx;
  background: #AFDCDF;
}

.page-section-spacing {
  margin-top: 60rpx;
}

.scroll-view_H {
  white-space: nowrap;
}

.scroll-view-item {
  height: 300rpx;
}

.scroll-view_box {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 5rpx;
}

.scroll-view-item_H {
  display: inline-block;
  min-width: 230rpx;
  height: 440rpx;
}

.guide-image {
  width: 100%;
  height: 350rpx;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.2);
  border-radius: 15rpx;
}

.guide-image .img {
  border-radius: 15rpx;
  width: 100%;
  height: 100%;
}

.guide-info {
  margin-top: 10rpx;
  white-space: normal;
  font-size: 28rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product {
  min-height: 500rpx;
  margin-top: 20rpx;
  background: #ffff;
  padding: 10rpx 20rpx 50rpx;
}

.product-box {
  display: grid;
  grid-template-columns: auto auto;
  row-gap: 25rpx;

}

.product-card {
  display: inline-block;
  width: 340rpx;
  margin-right: 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  transition: transform 0.2s ease;
}

.product-image {
  width: 100%;
  height: 280rpx;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  margin-bottom: 5rpx;
}

.product-image .img {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 20rpx 10rpx 5rpx;
  position: relative;
}

.product-name {
  height: 85rpx;
  padding: 0rpx 10rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-type {
  font-size: 25rpx;
  color: #999999;
  position: absolute;
  right: 20rpx;
  bottom: 50rpx;
  text-decoration: line-through;
}

.product-price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.product-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: bold;
  color: #ff6b35;
}

.price-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
  margin: 0 2rpx;
}

.price-unit {
  font-size: 22rpx;
  color: #999999;
  color: #ff6b35;
}

.product-sold {
  font-size: 25rpx;
  color: #999999;
}