.page-container {
  padding: 30rpx 30rpx;
}

.hero-banner {
  border: 1px solid;
  width: 100%;
  height: 480rpx;
  border-radius: 30rpx;
}


.product-card {
  width: 100%;
  height: 360rpx;
  margin-top: 60rpx;
  display: flex;
  position: relative;
}

.product-card__cover {
  width: 220rpx;
  height: 100%;
  margin-right: 26rpx;
  border-radius: 0rpx 20rpx 20rpx 0rpx;
}

.product-card__info {
  font-weight: 900;
}

.product-card__box {
  color: #ADADAD;
}

.card-height {
  margin-top: 10rpx;
}

.product-card__title {
  font-size: 38rpx;
  width: 430rpx;
  color: black;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-card__tags {
  font-weight: 200;
  display: flex;
}

.product-card__tag {
  font-weight: 200;
  font-size: 28rpx;
  border: 1px solid;
  border-radius: 0rpx 15rpx 0rpx 15rpx;
  padding: 4rpx 10rpx;
  margin-right: 10rpx;
}

.product-card__price {
  color: red;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  font-weight: 200;
  position: absolute;
  bottom: 0rpx;
}

.product-card__price-num {
  font-size: 44rpx;
  font-weight: 900;
  margin: 0rpx 8rpx;

}